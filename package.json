    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.6.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
