    "@vercel/speed-insights": "^2.0.0",
    "js-yaml": "^4.3.2",
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
