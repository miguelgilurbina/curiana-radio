  "description": "**88.8 FM - Transmisión Cultural desde Abya Yala**",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pruebas": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/pruebas/*.test.mjs",
